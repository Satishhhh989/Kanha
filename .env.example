# ==========================================
# KAHNA Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# OpenRouter LLM API Key (Get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# Server Settings
KAHNA_ENVIRONMENT=development
KAHNA_LOG_LEVEL=INFO
KAHNA_HOST=127.0.0.1
KAHNA_PORT=8765

# Telegram Bot Settings (Get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (Get your ID by messaging @userinfobot on Telegram)
# Supports single ID or comma-separated list for multiple users: e.g. 123456789,987654321
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here
